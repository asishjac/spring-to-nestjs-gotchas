{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "rootDir": ".",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "isolatedModules": true
  },
  "include": [
    "src",
    "test"
  ]
}
